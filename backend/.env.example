APP_NAME=ShopFlow API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-this-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
DATABASE_URL=sqlite:///./shopflow.db
# Comma-separated web origins. Add deployed frontend origins in the backend environment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_BOOTSTRAP_SECRET=
M_PESA_CONSUMER_KEY=
M_PESA_CONSUMER_SECRET=
M_PESA_PUBLIC_KEY=
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
