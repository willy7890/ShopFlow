APP_NAME=ShopFlow API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-this-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
DATABASE_URL=sqlite:///./shopflow.db
# Comma-separated web origins. Add deployed frontend origins in the backend environment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
# Set only for the designated platform administrator. Bootstrap also requires a verified email,
# an authenticated account, and a separately configured bootstrap secret.
SUPER_ADMIN_EMAIL=wilbardmagaso777@gmail.com
SUPER_ADMIN_BOOTSTRAP_SECRET=
# Add verified manual payment instructions; leave blank until confirmed.
SUBSCRIPTION_PAYMENT_INSTRUCTIONS=
# Set this to the public API verification endpoint. Use HTTPS outside local development.
EMAIL_VERIFICATION_BASE_URL=http://localhost:8000/api/v1/auth/verify-email
PASSWORD_RESET_BASE_URL=http://localhost:8000/api/v1/auth/password-reset
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_PER_HOUR=5
EMAIL_VERIFICATION_TOKEN_MINUTES=30
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_PER_HOUR=5
# Local development: point this at Mailpit or another local SMTP test server.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=shopflow@localhost
SMTP_FROM_NAME=ShopFlow
SMTP_STARTTLS=false
SMTP_USE_SSL=false
M_PESA_CONSUMER_KEY=
M_PESA_CONSUMER_SECRET=
M_PESA_PUBLIC_KEY=
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=20
